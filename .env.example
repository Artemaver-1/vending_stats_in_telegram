# Token from @BotFather
BOT_TOKEN=123456:replace-me
# Comma-separated Telegram IDs of admins; staff are added from the admin panel
ADMIN_IDS=111111111
# Optional fixed HTTPS address of the Mini App (otherwise taken from the Cloudflare tunnel)
WEBAPP_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vending
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vending

TIMEZONE=Asia/Yekaterinburg
LOG_LEVEL=INFO

# SmartVend telemetry (Settings -> Integration -> API)
SMARTVEND_API_KEY=smvd_replace-me
SMARTVEND_BASE_URL=https://api.smartvend.ru/v1.2

# --- Serverless deployment (deploy/yandex), kept in .env.cloud ---
# Hosted Postgres, e.g. Supabase session pooler; wins over POSTGRES_*
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# Telegram relay from deploy/telegram-relay; Telegram can't reach Russian clouds directly
# TELEGRAM_API_URL=https://silomery-hook.<subdomain>.workers.dev
# Opens the webhook and the job endpoints the cloud timers call
# HOOK_SECRET=long-random-string
